# FlowOS .gitignore
# Windows-first lokalni lični operativni sistem

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Node / Electron
node_modules/
out/
release/

# SQLite
*.db
*.sqlite
*.sqlite3

# Okruženje
.env
.env.*
!.env.example

# Tajne / kredencijali
*.pem
*.key
*.p12
*.pfx
credentials.json
*_credentials.*

# Logovi
*.log
logs/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store
Desktop.ini

# FlowOS interni
.flowos/
worktrees/

# Probe fajlovi (throwaway prototipovi)
probe_*

# Backup
*.bak
*.backup
backups/