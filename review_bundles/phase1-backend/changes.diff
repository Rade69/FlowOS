@@ -0,0 +1,59 @@
+"""Project Service — CRUD za projekte.
+
+Koristi SQLAlchemy Session za perzistenciju.
+Ne sme se importovati iz View ili Controller slojeva.
+"""
+
+from sqlalchemy.orm import Session
+
