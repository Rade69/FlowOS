+    def name_not_empty(cls, v: str) -> str:
+        stripped = v.strip()
+        if not stripped:
+            raise ValueError("Ime projekta ne sme biti prazno")
+        if len(stripped) > 200:
+            raise ValueError("Ime projekta sme imati najviše 200 karaktera")
+        return stripped
+
+    @field_validator("repo_path")
